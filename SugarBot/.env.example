# ======================================================================
# EXEMPLE DE CONFIGURATION POUR SUGAR BOT (NEUTRE)
# ======================================================================
# Copiez ce fichier en .env et remplissez vos vraies clés
# NE COMMITEZ JAMAIS LE FICHIER .env !

# ======================================================================
# DISCORD
# ======================================================================
# Token de votre bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=VOTRE_TOKEN_DISCORD_ICI

# ======================================================================
# GOOGLE GEMINI (Priorité 1)
# ======================================================================
# Obtenez vos clés sur https://aistudio.google.com/apikey
# Utilisez 3-4 clés pour rotation automatique
GEMINI_KEY_1=VOTRE_CLE_GEMINI_SUGAR_1
GEMINI_KEY_2=VOTRE_CLE_GEMINI_SUGAR_2
GEMINI_KEY_3=VOTRE_CLE_GEMINI_SUGAR_3
GEMINI_KEY_4=VOTRE_CLE_GEMINI_SUGAR_4

# ======================================================================
# APIS FALLBACK (Optionnel mais recommandé)
# ======================================================================

# Groq (https://console.groq.com/) - Très rapide, gratuit
GROQ_API_KEY=VOTRE_CLE_GROQ

# Mistral (https://console.mistral.ai/) - Premium, intelligent
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL

# OpenRouter (https://openrouter.ai/) - Fallback universel
OPENROUTER_API_KEY=VOTRE_CLE_OPENROUTER

# ======================================================================
# CONFIGURATION
# ======================================================================
# Canal de publication des posts (optionnel)
PUBLICATION_CHANNEL_ID=ID_DU_CANAL

# === Cle API NVIDIA (nemotron) - SUGARBOT UNIQUEMENT ===
# Repli envisage depuis le plafonnement de la famille mistral-* (429 permanent, 2026-09-04).
# Console : https://build.nvidia.com  ->  point d'entree https://integrate.api.nvidia.com/v1
# Laisser vide tant que la cle n'est pas a vous : un champ vide est ignore par le bot,
# ce qui vaut toujours mieux que la cle d'un autre bot.
NVIDIA_API_KEY=VOTRE_CLE_NVIDIA_SUGARBOT

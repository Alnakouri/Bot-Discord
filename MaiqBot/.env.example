# =============================================================================
# CONFIGURATION API - M'AIQ LE MENTEUR (The Liar)
# =============================================================================
# ⚠️ NE JAMAIS COMMITER CE FICHIER !
# Chaque bot a ses PROPRES clés API - NE PAS partager avec Sheogorath ou Alfred

# Discord Bot Token (Obligatoire)
DISCORD_TOKEN=VOTRE_TOKEN_DISCORD_MAIQ

# === Clés API Gemini (Google) - M'AIQ UNIQUEMENT ===
# Utilisez UNIQUEMENT les clés attribuées à M'aiq
# Le bot fait une rotation automatique entre ces clés
GEMINI_KEY_1=VOTRE_CLE_GEMINI_MAIQ_1
GEMINI_KEY_2=VOTRE_CLE_GEMINI_MAIQ_2
GEMINI_KEY_3=VOTRE_CLE_GEMINI_MAIQ_3

# === Clés API Groq (Llama) - M'AIQ UNIQUEMENT ===
GROQ_API_KEY=VOTRE_CLE_GROQ_MAIQ

# === Clés API Mistral - M'AIQ UNIQUEMENT ===
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL_MAIQ

# === Clés API xAI (Grok) - M'AIQ UNIQUEMENT ===
XAI_API_KEY=VOTRE_CLE_XAI_MAIQ

# === Clés API OpenRouter - M'AIQ UNIQUEMENT ===

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# 1. Remplacez TOUS les "VOTRE_CLE_..." par vos vraies clés API
# 2. Ces clés sont UNIQUEMENT pour M'aiq le Menteur
# 3. Sheogorath et Alfred ont leurs propres fichiers .env séparés
# 4. Ne partagez JAMAIS ces clés entre bots
# 5. Ajoutez plus de clés Gemini si besoin (GEMINI_KEY_4, etc.)

# === Cle API NVIDIA (nemotron) - MAIQ UNIQUEMENT ===
# Repli envisage depuis le plafonnement de la famille mistral-* (429 permanent, 2026-09-04).
# Console : https://build.nvidia.com  ->  point d'entree https://integrate.api.nvidia.com/v1
# Laisser vide tant que la cle n'est pas a vous : un champ vide est ignore par le bot,
# ce qui vaut toujours mieux que la cle d'un autre bot.
NVIDIA_API_KEY=VOTRE_CLE_NVIDIA_MAIQ

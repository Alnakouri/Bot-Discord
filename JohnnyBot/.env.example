# ======================================================================
# EXEMPLE DE CONFIGURATION POUR JOHNNY SILVERBOT
# ======================================================================
# Copiez ce fichier en .env et remplissez vos vraies clés
# NE COMMITEZ JAMAIS LE FICHIER .env !

# ======================================================================
# DISCORD
# ======================================================================
# Token de votre bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=VOTRE_TOKEN_DISCORD_ICI

# ======================================================================
# GOOGLE GEMINI (Priorité 1)
# ======================================================================
# Obtenez vos clés sur https://aistudio.google.com/apikey
# Utilisez 3-4 clés pour rotation automatique
GEMINI_KEY_1=VOTRE_CLE_GEMINI_1
GEMINI_KEY_2=VOTRE_CLE_GEMINI_2
GEMINI_KEY_3=VOTRE_CLE_GEMINI_3
GEMINI_KEY_4=VOTRE_CLE_GEMINI_4

# ======================================================================
# APIS FALLBACK (Optionnel mais recommandé)
# ======================================================================

# Groq (https://console.groq.com/) - Très rapide, gratuit
GROQ_API_KEY=VOTRE_CLE_GROQ

# Mistral (https://console.mistral.ai/) - Premium, intelligent
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL

# OpenRouter (https://openrouter.ai/) - Fallback universel
OPENROUTER_API_KEY=VOTRE_CLE_OPENROUTER

# ======================================================================
# CONFIGURATION
# ======================================================================
# Canal de publication des posts (optionnel)
PUBLICATION_CHANNEL_ID=ID_DU_CANAL

# ======================================================================
# TWITCH (chat permanent + events + channel points) — COMPTE DÉDIÉ JOHNNY
# ======================================================================
# 1 app Twitch PROPRE à Johnny (https://dev.twitch.tv/console) — ne JAMAIS
# réutiliser l'app/token de Sheo. OAuth Redirect URL de l'app : http://localhost:3000
TWITCH_CLIENT_ID=CLIENT_ID_DE_L_APP_JOHNNY
TWITCH_CLIENT_SECRET=CLIENT_SECRET_DE_L_APP_JOHNNY
# Pseudo du compte Twitch dédié à Johnny (tel qu'affiché dans le chat)
TWITCH_BOT_USERNAME=compte_twitch_johnny
# Chaîne(s) où Johnny se connecte (CSV) — peut être la même que Sheo
TWITCH_CHAT_CHANNELS=ta_chaine
# Tokens générés par :  python twitch_authorize.py --bot johnny --client-id ... --client-secret ...
# (le helper écrit aussi data/twitch_chat_auth_johnny.json, qui prime ensuite)
TWITCH_OAUTH_TOKEN=GENERE_PAR_twitch_authorize.py
TWITCH_REFRESH_TOKEN=GENERE_PAR_twitch_authorize.py
# Optionnel : forcer une bio / couleur de départ (sinon la persona choisit 1x/jour)
# TWITCH_PROFILE_BIO=
# TWITCH_CHAT_COLOR=blue_violet
# Pseudos Twitch des AUTRES bots à ignorer (anti-boucle inter-bots), CSV. Met ici le
# pseudo Twitch de Sheo (et des autres bots présents sur la chaîne). Ex :
TWITCH_PEER_BOTS=compte_bot_sheo

# === Cle API NVIDIA (nemotron) - JOHNNY UNIQUEMENT ===
# Repli envisage depuis le plafonnement de la famille mistral-* (429 permanent, 2026-09-04).
# Console : https://build.nvidia.com  ->  point d'entree https://integrate.api.nvidia.com/v1
# Laisser vide tant que la cle n'est pas a vous : un champ vide est ignore par le bot,
# ce qui vaut toujours mieux que la cle d'un autre bot.
NVIDIA_API_KEY=VOTRE_CLE_NVIDIA_JOHNNY

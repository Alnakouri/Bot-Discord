# =============================================================================
# CONFIGURATION API - MALENA LE MENTEUR (The Liar)
# =============================================================================
# ⚠️ NE JAMAIS COMMITER CE FICHIER !
# Chaque bot a ses PROPRES clés API - NE PAS partager avec Sheogorath ou Alfred

# Discord Bot Token (Obligatoire)
DISCORD_TOKEN=VOTRE_TOKEN_DISCORD_MALENA

# === Clés API Gemini (Google) - MALENA UNIQUEMENT ===
# Utilisez UNIQUEMENT les clés attribuées à Malena
# Le bot fait une rotation automatique entre ces clés
GEMINI_KEY_1=VOTRE_CLE_GEMINI_MALENA_1
GEMINI_KEY_2=VOTRE_CLE_GEMINI_MALENA_2
GEMINI_KEY_3=VOTRE_CLE_GEMINI_MALENA_3

# === Clés API Groq (Llama) - MALENA UNIQUEMENT ===
GROQ_API_KEY=VOTRE_CLE_GROQ_MALENA

# === Clés API Mistral - MALENA UNIQUEMENT ===
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL_MALENA

# === Clés API xAI (Grok) - MALENA UNIQUEMENT ===
XAI_API_KEY=VOTRE_CLE_XAI_MALENA

# === Clés API OpenRouter - MALENA UNIQUEMENT ===

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# 1. Remplacez TOUS les "VOTRE_CLE_..." par vos vraies clés API
# 2. Ces clés sont UNIQUEMENT pour Malena
# 3. Sheogorath et Alfred ont leurs propres fichiers .env séparés
# 4. Ne partagez JAMAIS ces clés entre bots
# 5. Ajoutez plus de clés Gemini si besoin (GEMINI_KEY_4, etc.)

# === Cle API NVIDIA (nemotron) - MALENA UNIQUEMENT ===
# Repli envisage depuis le plafonnement de la famille mistral-* (429 permanent, 2026-09-04).
# Console : https://build.nvidia.com  ->  point d'entree https://integrate.api.nvidia.com/v1
# Laisser vide tant que la cle n'est pas a vous : un champ vide est ignore par le bot,
# ce qui vaut toujours mieux que la cle d'un autre bot.
NVIDIA_API_KEY=VOTRE_CLE_NVIDIA_MALENA

# === Cle API AI/ML API (agregateur) - MALENA UNIQUEMENT ===
# Ajoute le 2026-09-20. Un seul point d'entree compatible OpenAI qui sert les modeles
# de plusieurs fournisseurs : https://api.aimlapi.com/v1
# Console / cles : https://aimlapi.com/app/keys
# Il repond a deux impasses mesurees : gemma-4 mort chez NVIDIA depuis le 18/09, et la
# famille mistral-* qui rend 429 par MODELE depuis le 04/09.
# ⚠️ UNE CLE PAR BOT. Un emplacement laisse vide est ignore par le bot, ce qui vaut
#    toujours mieux que la cle d'un voisin : une cle mutualisee ne se voit plus, et
#    c'est exactement ce qui avait fausse le diagnostic des quotas Gemini.
AIMLAPI_API_KEY=VOTRE_CLE_AIMLAPI_MALENA


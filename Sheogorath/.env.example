# =============================================================================
# CONFIGURATION API - SHEOGORATH (Le Prince de la Folie)
# =============================================================================
# ⚠️ NE JAMAIS COMMITER CE FICHIER !
# Chaque bot a ses PROPRES clés API - NE PAS partager avec M'aiq ou Alfred

# Discord Bot Token (Obligatoire)


# === Clés API Gemini (Google) - SHEOGORATH UNIQUEMENT ===
# Utilisez UNIQUEMENT les clés attribuées à Sheogorath
# Le bot fait une rotation automatique entre ces clés
GEMINI_KEY_1=VOTRE_CLE_GEMINI_SHEO_1
GEMINI_KEY_2=VOTRE_CLE_GEMINI_SHEO_2
GEMINI_KEY_3=VOTRE_CLE_GEMINI_SHEO_3

# === Clés API Groq (Llama) - SHEOGORATH UNIQUEMENT ===
GROQ_API_KEY=VOTRE_CLE_GROQ_SHEOGORATH

# === Clés API Mistral - SHEOGORATH UNIQUEMENT ===
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL_SHEOGORATH

# === Clés API xAI (Grok) - SHEOGORATH UNIQUEMENT ===
XAI_API_KEY=VOTRE_CLE_XAI_SHEOGORATH

# === Clés API OpenRouter - SHEOGORATH UNIQUEMENT ===
OPENROUTER_API_KEY=VOTRE_CLE_OPENROUTER_SHEOGORATH

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# 1. Remplacez TOUS les "VOTRE_CLE_..." par vos vraies clés API
# 2. Ces clés sont UNIQUEMENT pour Sheogorath
# 3. M'aiq et Alfred ont leurs propres fichiers .env séparés
# 4. Ne partagez JAMAIS ces clés entre bots
# 5. Ajoutez plus de clés Gemini si besoin (GEMINI_KEY_4, etc.)

# === Cle API NVIDIA (nemotron) - SHEOGORATH UNIQUEMENT ===
# Repli envisage depuis le plafonnement de la famille mistral-* (429 permanent, 2026-09-04).
# Console : https://build.nvidia.com  ->  point d'entree https://integrate.api.nvidia.com/v1
# Laisser vide tant que la cle n'est pas a vous : un champ vide est ignore par le bot,
# ce qui vaut toujours mieux que la cle d'un autre bot.
NVIDIA_API_KEY=VOTRE_CLE_NVIDIA_SHEOGORATH

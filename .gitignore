# Tests et debug : scripts ad-hoc DE LA RACINE (test_bot, check_stt, etc.).
# Le « / » initial est vital. Sans lui, la règle s'applique à TOUS les niveaux :
# elle a avalé shared/test_mode.py — le module qui empêche les bots de publier en
# public — pendant tout le commit 7278ca3, sans que rien ne le signale (les bots
# l'importent sous try/except, donc un clone frais perdait le garde-fou EN SILENCE).
/test_*.py
/check_*.py
/*_test.py
debug/
diag_results.txt
found_models.txt
valid_models.txt
diagnostic_output.txt

# Discloud
.discloudignore
node_modules/

_temporary_keys.txt

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# ───────────────────────────────────────────────────────────────
# Données runtime / modèles IA — NE JAMAIS COMMITER (ajout 2026-06-02)
# ───────────────────────────────────────────────────────────────

# Stockage Ollama (blobs de modèles ~1,6 Go + clé privée d'identité)
ollama_storage/

# Modèle de synthèse vocale Piper (~60 Mo)
piper-data/

# Serveur Chatterbox : ignorer les gros modèles/voix, GARDER le code source
# (server.py, extract_voice.py, Dockerfile, voices/concat.txt restent trackés)
chatterbox-server/voices/*.onnx
chatterbox-server/voices/*.pt
chatterbox-server/voices/*.bin
chatterbox-server/voices/*.safetensors
# (les *.wav sont déjà couverts par la règle globale *.wav)

# Logs structurés JSON Lines (la règle *.log ne les couvre PAS)
*.jsonl
logs/


# ======================================================================
# CONFIGURATION DU DASHBOARD
# Copiez ce fichier en dashboard/.env et renseignez le mot de passe.
# NE COMMITEZ JAMAIS dashboard/.env !
# ======================================================================

# Mot de passe d'accès au dashboard (obligatoire).
# Sans lui, l'API du dashboard reste verrouillée (fail-closed).
# Choisissez une valeur longue et unique.
DASHBOARD_PASSWORD=changez-moi-par-un-mot-de-passe-fort
